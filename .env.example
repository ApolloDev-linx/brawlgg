# Database - use a PostgreSQL connection string
# For local dev: postgresql://user:password@localhost:5432/apollo_meta
# For Railway/Supabase: get the connection string from their dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/apollo_meta"

# Redis - optional, falls back to in-memory cache if not set
# For Upstash: get the URL from their dashboard
# For local: redis://localhost:6379
REDIS_URL=""

# Brawl Stars API key - get one at https://developer.brawlstars.com
BRAWL_STARS_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
